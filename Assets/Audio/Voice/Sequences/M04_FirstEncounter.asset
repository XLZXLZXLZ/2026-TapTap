  Segments:
  - Clip: {fileID: 8300000, guid: 43ec67b21c235dfdaa3653e593c01f66, type: 3}
    Subtitles:
    - Start: 0.1051
      End: 2.6871
      Chinese: "您的移交表应随设备保存。"
      English: "Your transfer form should stay with the equipment."
    - Start: 3.1476
      End: 5.4493
      Chinese: "用途一栏可以留空。"
      English: "The purpose field may be left blank."
    - Start: 6.1901
      End: 10.4335
      Chinese: "如设备经过改装，请用自己的话填写新的描述。"
      English: "For modified equipment, enter a new description in your own words."
    - Start: 11.0542
      End: 13.456
      Chinese: "额外表纸可向办公室领取。"
      English: "Extra sheets are available from the office."
    - Start: 14.0566
      End: 19.0606
      Chinese: "旧标签请随表附上，便于核对改装前的记录。"
      English: "Attach the old label so staff can check the records from before the modification."
    Chinese: ""
    English: ""
